{
  "manifest_version": 3,
  "name": "AI Leak Guard Public",
  "version": "0.1.0",
  "description": "Open-source private AI workspace with offline redaction and local response restoration.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://grok.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*",
    "https://chat.mistral.ai/*",
    "https://poe.com/*",
    "https://you.com/*",
    "https://huggingface.co/*",
    "https://qwen.ai/*",
    "https://chat.qwen.ai/*",
    "https://www.kimi.com/*",
    "https://kimi.com/*",
    "https://kimi.moonshot.cn/*",
    "https://www.doubao.com/*",
    "https://doubao.com/*",
    "https://chat.z.ai/*",
    "https://yuanbao.tencent.com/*",
    "https://www.wenxiaoyan.com/*",
    "https://yiyan.baidu.com/*",
    "https://character.ai/*",
    "https://arena.ai/*",
    "https://lmarena.ai/*",
    "https://chat.lmsys.org/*",
    "https://aistudio.google.com/*",
    "https://notebook.google.com/*",
    "https://notebooklm.google.com/*",
    "https://duck.ai/*",
    "https://duckduckgo.com/*",
    "https://giga.chat/*",
    "https://developers.sber.ru/*",
    "https://alice.yandex.ru/*",
    "https://app.jasper.ai/*",
    "https://app.writesonic.com/*",
    "https://app.copy.ai/*",
    "https://dashboard.cohere.com/*",
    "https://chat.cohere.com/*",
    "https://coral.cohere.com/*",
    "https://app.reka.ai/*",
    "https://chat.reka.ai/*"
  ],
  "background": {
    "service_worker": "src/extension/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open private composer",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png"
    }
  },
  "options_page": "src/ui/admin.html",
  "storage": {
    "managed_schema": "managed-schema.json"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://www.meta.ai/*",
        "https://meta.ai/*",
        "https://chat.mistral.ai/*",
        "https://poe.com/*",
        "https://you.com/*",
        "https://huggingface.co/*",
        "https://qwen.ai/*",
        "https://chat.qwen.ai/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*",
        "https://chat.z.ai/*",
        "https://yuanbao.tencent.com/*",
        "https://www.wenxiaoyan.com/*",
        "https://yiyan.baidu.com/*",
        "https://character.ai/*",
        "https://arena.ai/*",
        "https://lmarena.ai/*",
        "https://chat.lmsys.org/*",
        "https://aistudio.google.com/*",
        "https://notebook.google.com/*",
        "https://notebooklm.google.com/*",
        "https://duck.ai/*",
        "https://duckduckgo.com/*",
        "https://giga.chat/*",
        "https://developers.sber.ru/*",
        "https://alice.yandex.ru/*",
        "https://app.jasper.ai/*",
        "https://app.writesonic.com/*",
        "https://app.copy.ai/*",
        "https://dashboard.cohere.com/*",
        "https://chat.cohere.com/*",
        "https://coral.cohere.com/*",
        "https://app.reka.ai/*",
        "https://chat.reka.ai/*"
      ],
      "js": ["content.bundle.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "minimum_chrome_version": "120",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'; img-src 'self'; style-src 'self'"
  }
}
